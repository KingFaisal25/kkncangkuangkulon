# URL Backend API (Laravel) - baked into the build.
# Domain produksi: kkncangkuangkulon.my.id
#
# Opsi A (DEFAULT): backend ditaruh di folder /api_laravel pada domain utama
#   -> cocok kalau belum buat subdomain terpisah & SSL hanya di domain utama.
VITE_API_BASE_URL=https://kkncangkuangkulon.my.id/api_laravel/public/api
#
# Opsi B: kalau sudah buat subdomain api.kkncangkuangkulon.my.id (paling bersih),
# ganti baris di atas menjadi:
# VITE_API_BASE_URL=https://api.kkncangkuangkulon.my.id/api
