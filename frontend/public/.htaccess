# ─────────────────────────────────────────────────────────
#  Absen-KKN Frontend (Vite/React SPA) — Apache config
#  For CentOS Web Panel (CWP) / cPanel-style shared hosting
# ─────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # 1) Force HTTPS (uncomment after SSL is active in CWP)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) SPA history fallback: real files/assets are served as-is;
  #    everything else falls back to index.html (React Router).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# 3) Long-cache hashed Vite assets (filename includes content hash)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # index.html must never be cached so deploys take effect immediately
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 4) Gzip text responses (if mod_deflate present; Nginx may also do this)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# 5) Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>